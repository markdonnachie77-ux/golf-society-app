# Supabase connection settings.
#
# Local Docker stack (`npx supabase start` — see README "Option A"):
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY=<copy the "service_role key" line from the
#                               `supabase start` output>
#
# Hosted project (README "Option B", Project Settings → API):
#   SUPABASE_URL=https://your-project-ref.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=<the service_role key from Project Settings>
#   (⚠️ server-only — never put this in a NEXT_PUBLIC_* var or ship it to the browser)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random string, 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Multi-tenant subdomain resolution (see README's "Future-proofing for
# multi-tenancy" and middleware.ts). Leave UNSET for a single-tenant
# deployment (like this one) — every request resolves to the one seeded
# default society regardless, so this is entirely opt-in.
#
# Once you have a real platform domain for a shared multi-tenant
# deployment, set this to it (no protocol, no subdomain):
#   PLATFORM_ROOT_DOMAIN=example.com
# Then requests to tenant-a.example.com / tenant-b.example.com resolve to
# whichever society has that slug. For local testing before you own a
# real platform domain, use "something.localhost:3000" in your browser —
# no env var or /etc/hosts changes needed, modern browsers resolve any
# *.localhost subdomain to 127.0.0.1 automatically.
# PLATFORM_ROOT_DOMAIN=
