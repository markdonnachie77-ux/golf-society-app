# Supabase connection settings.
#
# Local Docker stack (`npx supabase start` — see README "Option A"):
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY=<copy the "service_role key" line from the
#                               `supabase start` output>
#
# Hosted project (README "Option B", Project Settings → API):
#   SUPABASE_URL=https://your-project-ref.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=<the service_role key from Project Settings>
#   (⚠️ server-only — never put this in a NEXT_PUBLIC_* var or ship it to the browser)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random string, 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string
